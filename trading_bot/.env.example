# ===== Telegram 설정 =====
# https://my.telegram.org 에서 발급
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# 시그널을 수신할 채널 목록 (쉼표로 구분, @ 없이)
# 예: rich_adul,au_call,MetaGambler,DegenSeals
SIGNAL_SOURCES=rich_adul,au_call,MetaGambler,DegenSeals,theosjournal1,TrissysEdge,PowsGemCalls,fttrenches_sol,fttrenches_volsm,missorplays

# ===== Solana 지갑 설정 =====
# 지갑의 Private Key (Base58 인코딩)
# 예: Phantom 지갑 → 설정 → Export Private Key
WALLET_PRIVATE_KEY=your_base58_private_key_here

# Solana RPC URL (무료: mainnet-beta, 유료: Helius, QuickNode 권장)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ===== 매매 설정 =====
# 시그널당 투자 비율 — 현재 SOL 잔액의 몇 %를 사용할지 (복리식)
# 0.10 = 10% (잔액 $365 기준 시 시그널당 $36.5 투자)
TRADE_AMOUNT_PCT=0.10

# 익절 수익률 (0.20 = 20%)
TAKE_PROFIT_RATIO=0.20

# 손절 손실률 (0.30 = 30%)
STOP_LOSS_RATIO=0.30

# 가격 모니터링 주기 (초)
PRICE_CHECK_INTERVAL=30

# 슬리피지 허용치 (bps, 100 = 1%)
# 밈코인은 유동성이 낮아 300 (3%) 권장
SLIPPAGE_BPS=300

# 예상 왕복 수수료 (bps, 100 = 1%)
# P&L 표시 시 차감용 (트리거 기준에는 영향 없음)
# Jupiter 우선순위 수수료 + 네트워크 수수료 합산 추정
FEE_ESTIMATE_BPS=100
